# Copiar a .env y ajustar por cada instalación de cliente. Nunca subir .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=cambia-esta-clave

# --- API ---
API_PORT=8080
# Orígenes del frontend (otro repositorio), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Seguridad ---
# Clave de firma de los JWT: única por cliente, mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Primer administrador: se crea solo si la base de datos no tiene usuarios.
# La contraseña es temporal: hay que cambiarla en el primer inicio de sesión.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# --- Datos de mercado ---
# fixed = variación constante (demo/desarrollo) | alphavantage = datos reales
MARKET_PROVIDER=fixed
FIXED_VARIATION_PCT=1.0
ALPHAVANTAGE_API_KEY=
# Tiempo que se reutiliza la variación cacheada (protege la cuota de 25 llamadas/día)
MARKET_CACHE_TTL=6h

# --- Alertas con IA ---
# template = texto con reglas, sin llamadas externas (por defecto) | gemini = Google Gemini
AI_PROVIDER=template
# Clave gratuita en https://aistudio.google.com/apikey (solo si AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tope de gasto mensual en USD y precios por millón de tokens (0 = capa gratuita)
AI_MONTHLY_BUDGET_USD=5
AI_INPUT_PRICE_PER_MTOK=0
AI_OUTPUT_PRICE_PER_MTOK=0

# --- Noticias ---
# fixed = artículos de ejemplo (demo/desarrollo) | alphavantage = NEWS_SENTIMENT (usa ALPHAVANTAGE_API_KEY)
NEWS_PROVIDER=fixed
# Cron de Spring (segundo minuto hora día mes día-semana), en la zona horaria de la instalación
NEWS_REFRESH_CRON=0 0 */6 * * *
# Tope de descargas por día: la cuota gratuita (25/día) se comparte con los datos de mercado
NEWS_MAX_DAILY_CALLS=4
NEWS_REFRESH_ON_STARTUP=true

# --- Notificaciones ---
# SMTP del cliente. Sin MAIL_HOST el correo queda desactivado y solo se usa la bandeja de la app.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=RiTech <no-reply@empresa.com>
# Umbral por defecto (|variación diaria| en %) para avisar a cada usuario; cada uno puede cambiarlo
NOTIFICATION_VARIATION_THRESHOLD_PCT=2.00
