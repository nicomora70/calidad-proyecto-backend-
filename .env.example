# Copiar a .env y ajustar por cada instalación de cliente. Nunca subir .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=cambia-esta-clave

# --- API ---
API_PORT=8080
# Orígenes del frontend (otro repositorio), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Seguridad ---
# Clave de firma de los JWT: única por cliente, mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Primer administrador: se crea solo si la base de datos no tiene usuarios.
# La contraseña es temporal: hay que cambiarla en el primer inicio de sesión.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# --- Datos de mercado ---
# fixed = variación constante (demo/desarrollo) | alphavantage = datos reales
MARKET_PROVIDER=fixed
FIXED_VARIATION_PCT=1.0
ALPHAVANTAGE_API_KEY=
# Tiempo que se reutiliza la variación cacheada (protege la cuota de 25 llamadas/día)
MARKET_CACHE_TTL=6h
